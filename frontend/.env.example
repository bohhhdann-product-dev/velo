# Copy to .env. Never commit real credentials.
# Demo is an isolated UI sandbox. Live uses authenticated API data and no fake generations.
NUXT_PUBLIC_APP_MODE=demo

# Local PostgreSQL: docker compose up -d from the repository root.
DATABASE_URL=postgres://vela:vela_local_only@127.0.0.1:55432/vela

# Clerk Development instance. Pull the existing app's keys with Clerk CLI.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=
VELA_AUTH_MODE=clerk
VELA_ALLOWED_ORIGINS=http://localhost:3457,http://127.0.0.1:3457

# local keeps files outside the web public directory. S3 uses the SDK credential chain.
VELA_STORAGE_DRIVER=local
# Optional absolute path for local media. Default: ~/.local/share/vela/media
# VELA_STORAGE_DIR=/absolute/path/to/private/vela-media
AWS_REGION=eu-north-1
AWS_S3_BUCKET=
# AWS_PROFILE=vela

# Initial per-user limits; deleted files still count until cleanup.
VELA_MAX_ASSETS=500
VELA_MAX_STORAGE_BYTES=1073741824
VELA_MAX_UPLOADS_PER_HOUR=120

# BytePlus ModelArk. Leave disabled until account/model access and spending limits are ready.
# Only server/worker processes receive this key; never put it in NUXT_PUBLIC_*.
VELA_GENERATION_ENABLED=false
ARK_API_KEY=
# Singapore endpoint is validated; do not substitute a proxy URL.
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_IMAGE_MODEL=dola-seedream-5-0-pro-260628
ARK_VIDEO_MODEL=dreamina-seedance-2-5-260628
# Run pnpm generation:worker separately after enabling the provider.

# Voplica MiniMax H3 / H3 Eros Max Beta7. Server-only token.
VOPLICA_API_KEY=
VELA_VOPLICA_ENABLED=false
# Public contract check: pnpm voplica:check
# Authenticated validation, no spend: pnpm voplica:check --dry-run
# Enable both VELA_GENERATION_ENABLED and VELA_VOPLICA_ENABLED after validation.
