{
  "name": "vela-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test:studio": "node scripts/test-studio.mjs",
    "test:server": "tsx --test tests/server/*.test.ts",
    "media:cleanup": "node --env-file-if-exists=.env --import tsx scripts/cleanup-media.ts",
    "generation:worker": "node --env-file-if-exists=.env --import tsx scripts/generation-worker.ts",
    "test:live": "node scripts/test-live.mjs",
    "test:admin": "node scripts/test-admin-client.mjs",
    "voplica:check": "node --env-file-if-exists=.env --import tsx scripts/voplica-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@clerk/backend": "^3.31.4",
    "@clerk/nuxt": "^3.1.30",
    "@pinia/nuxt": "^0.11.2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "h3": "^1.15.11",
    "lucide-vue-next": "^0.462.0",
    "nuxt": "^4.6.2",
    "pinia": "^3.0.4",
    "postgres": "^4.1.1",
    "reka-ui": "^2.11.0",
    "sharp": "^0.35.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.3.14"
  }
}
